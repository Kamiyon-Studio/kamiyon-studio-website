# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
/blob-report
.nyc_output/

# next.js
/.next/
/out/
.turbo/

# production
/build
/dist/

# misc
.DS_Store
*.pem
.cache/
.eslintcache
.vitest/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Google API credentials (Search Console automation) — never commit
**/google-service-account*.json
**/*-googleapis*.json
**/gsc-credentials*.json
secrets/

# Cloudflare Wrangler local secrets (never commit)
.dev.vars
.dev.vars.*
!.dev.vars.example

# vercel
.vercel

# Cloudflare / OpenNext
.open-next/
.wrangler/

# local metadata
.claude/
.claude-flow/
.cursor/
.mcp.json

# sanity studio
.sanity/
sanity/.cache/
sanity/.sanity/
sanity-static/

# typescript
*.tsbuildinfo
next-env.d.ts

# graphify (regenerate: graphify update .)
/graphify-out/
